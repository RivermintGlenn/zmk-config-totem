//             ┃     [     ┃     {     ┃     }     ┃     ]     ┃     ?     ┃   ┃     .     ┃     !     ┃     @     ┃     #     ┃     ..    ┃
//             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
//             ┃     ^     ┃     =     ┃     _     ┃     $     ┃     *     ┃   ┃     ,     ┃     (     ┃     )     ┃     +     ┃     &     ┃
// ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
// ┃     ~     ┃     <     ┃     |     ┃     -     ┃     >     ┃     /     ┃   ┃     ;     ┃     "     ┃     '     ┃     `     ┃     \     ┃    ```    ┃
// ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
//                                     ┃     \     ┃     %     ┃     :     ┃   ┃           ┃    HELD   ┃           ┃
//                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
 bindings = <
                &kp LBKT    &kp LBRC    &kp RBRC    &kp RBKT    &kp QMARK       &kp DOT     &kp EXCL    &kp AT      &kp HASH    &dot_dot
                &kp CARET   &kp EQUAL   &kp UNDER   &kp DLLR    &kp STAR        &kp COMMA   &kp LPAR    &kp RPAR    &kp PLUS    &kp AMPS
    &kp TILDE   &kp LT      &kp PIPE    &kp MINUS   &kp GT      &kp FSLH        &kp SEMI    &kp DQT     &kp SQT     &kp GRAVE   &kp BSLH    &triple_backtick
                                        &kp BSLH    &kp PRCNT   &kp COLON       &trans      &trans      &trans
                        >;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄


                mouse_layer {
// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
display-name = "MOUSE";
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
//             ┃           ┃ SCRL LEFT ┃  MOVE UP  ┃ SCRL RGHT ┃           ┃   ┃ SCRL LEFT ┃  L CLICK  ┃  M CLICK  ┃  R CLICK  ┃ SCRL RGHT ┃
//             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
//             ┃  SCRL UP  ┃ MOVE LEFT ┃ MOVE DOWN ┃ MOVE RGHT ┃  SCRL UP  ┃   ┃  SCRL UP  ┃    FAST   ┃    WARP   ┃    SLOW   ┃    APP    ┃
// ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
// ┃           ┃ SCRL DOWN ┃    SLOW   ┃    WARP   ┃    FAST   ┃ SCRL DOWN ┃   ┃ SCRL DOWN ┃ MOVE LEFT ┃  MOVE UP  ┃ MOVE DOWN ┃ MOVE RGHT ┃    BACK   ┃
// ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
//                                     ┃  M CLICK  ┃  L CLICK  ┃  R CLICK  ┃   ┃    HELD   ┃    COPY   ┃   PASTE   ┃
//                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
 bindings = <
                &none       &msc SCROLL_LEFT &mmv MOVE_UP &msc SCROLL_RIGHT &none           &msc SCROLL_LEFT &mkp LCLK   &mkp MCLK   &mkp RCLK   &msc SCROLL_RIGHT
                &msc SCROLL_UP &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCROLL_UP     &msc SCROLL_UP &mo MOUSE_FAST &mo MOUSE_WARP &mo MOUSE_SLOW &kp K_APP
    &none       &msc SCROLL_DOWN &mo MOUSE_SLOW &mo MOUSE_WARP &mo MOUSE_FAST &msc SCROLL_DOWN     &msc SCROLL_DOWN &mmv MOVE_LEFT &mmv MOVE_UP &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp MB4
                                        &mkp MCLK   &mkp LCLK   &mkp RCLK       &trans      &kp _COPY   &kp _PASTE
                        >;
                };

